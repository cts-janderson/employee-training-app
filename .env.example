DATABASE_URL=postgresql://localhost:5432/employee_training
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DEV_AUTH_STUB=1
DEV_ADMIN_EMAIL=demo.admin@example.test
ORG_TIME_ZONE=America/New_York
NOTIFICATION_FROM_EMAIL=training@example.test
# localhost, not 127.0.0.1: passkeys refuse an IP address as the site.
APP_BASE_URL=http://localhost:8000

# Production only (DJANGO_DEBUG=0): APP_BASE_URL must be https and DJANGO_ALLOWED_HOSTS explicit.
# TRUSTED_PROXY_NETWORKS=172.18.0.0/16
# SECURE_HSTS_SECONDS=3600
# SESSION_COOKIE_AGE=43200
# LOG_LEVEL=INFO
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# MAIL_TIMEOUT_SECONDS=15
