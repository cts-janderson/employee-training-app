# Copy to .env.production (gitignored) and run every compose command with --env-file .env.production.
# Generate secrets with: openssl rand -hex 32   (hex keeps database passwords safe inside connection URLs)

# The public host name, without a scheme. The app is served at https://APP_HOST.
APP_HOST=training.critical-technology.com
# cloudflare: a public certificate through a DNS-01 challenge. internal: Caddy's own CA, for a local stack only.
TLS_MODE=cloudflare
# A Cloudflare API token with DNS edit rights on the critical-technology.com zone only.
CF_API_TOKEN=

DJANGO_SECRET_KEY=

# PostgreSQL. The superuser provisions roles only; migrate uses the owner and everything else uses the app role.
POSTGRES_DB=training
POSTGRES_PASSWORD=
TRAINING_OWNER_DB_PASSWORD=
TRAINING_APP_DB_PASSWORD=

# Mail through Microsoft Graph (ADR-0011).
NOTIFICATION_FROM_EMAIL=training@critical-technology.com
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# MAIL_TIMEOUT_SECONDS=15

ORG_TIME_ZONE=America/New_York
# APP_IMAGE_TAG=latest
# WEB_CONCURRENCY=3
# SECURE_HSTS_SECONDS=3600
# SESSION_COOKIE_AGE=43200
# LOG_LEVEL=INFO
